{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true, "skipLibCheck": true,
    "noEmit": true, "types": ["vite/client", "@types/wicg-file-system-access"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
